# =============================================================================
# KarosL — Docker Compose Environment Configuration
# =============================================================================
# Copy to .env in the repo root before running docker compose:
#   cp .env.example .env
#
# NEVER commit the real .env file. docker-compose.yml and docker-compose.dev.yml
# both read variables from this file automatically.
# =============================================================================

# --- PostgreSQL (docker-compose "db" service) ---
POSTGRES_DB=karosl
POSTGRES_USER=karosl_user
POSTGRES_PASSWORD=change_this_password

# --- Backend (Django) ---
# Must match the POSTGRES_* values above — the backend container connects to
# the "db" service over the compose network, not localhost.
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DB_ENGINE=django.db.backends.postgresql
DB_NAME=karosl
DB_USER=karosl_user
DB_PASSWORD=change_this_password
DB_HOST=db
DB_PORT=5432
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- Frontend (build-time only, see frontend/.env.example) ---
VITE_API_BASE_URL=/api

# --- Host ports (change if these are already taken on your machine) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432

# =============================================================================
# AWS STAGING (single EC2 + Docker Compose) — override the values above
# =============================================================================
# Full runbook: docs/AWS_EC2_DEPLOYMENT.md §5. Tick-list: docs/AWS_STAGING_CHECKLIST.md
#
# Create this file BY HAND on the EC2 instance (cp .env.example .env), then
# chmod 600 it. Never commit it; never paste its contents anywhere.
# Substitute <EC2_PUBLIC_IP> with the instance's real public IPv4 address.
#
# Only the root .env is needed on the server — docker-compose.yml passes it to
# the backend container via env_file. backend/.env and frontend/.env are for
# the native (non-Docker) workflow and are ignored by the compose stack.
#
# --- Secrets: generate fresh for staging, never reuse dev or production ---
# SECRET_KEY:        docker run --rm python:3.12-slim python -c \
#                      "import secrets,string; print(''.join(secrets.choice(
#                       string.ascii_letters+string.digits) for _ in range(50)))"
# POSTGRES_PASSWORD: openssl rand -base64 32
#
# SECRET_KEY=<GENERATED_SECRET_KEY>
# POSTGRES_PASSWORD=<STRONG_DB_PASSWORD>
# DB_PASSWORD=<STRONG_DB_PASSWORD>          # MUST be identical to POSTGRES_PASSWORD
# DEBUG=False
#
# --- Host / origin: all three must name the EC2 public IP ---
# Keep localhost and 127.0.0.1 in ALLOWED_HOSTS — the backend container's
# Docker HEALTHCHECK curls http://localhost:8000/api/health/, and Django
# returns 400 for an unlisted Host, which marks the container permanently
# unhealthy even though the app works fine. Keep "backend" too: that is the
# compose hostname nginx proxies to.
# ALLOWED_HOSTS=<EC2_PUBLIC_IP>,localhost,127.0.0.1,backend
#
# Scheme included, NO trailing slash, http:// until TLS actually exists.
# CSRF_TRUSTED_ORIGINS=http://<EC2_PUBLIC_IP>
# CORS_ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP>
# CORS_ALLOW_ALL_ORIGINS=False
#
# --- Database ---
# Two valid setups, mutually exclusive — pick one:
#
# (a) Local Postgres container (original design, still the default for a
#     fresh checkout). DB_HOST is the compose service name, never localhost —
#     inside the backend container, localhost is the backend itself.
# DB_ENGINE=django.db.backends.postgresql
# DB_HOST=db
# DB_PORT=5432
#
# (b) Amazon RDS (live on staging since 2026-08-19, docs/RDS_MIGRATION.md).
#     Requires the docker-compose.rds.yml overlay (auto-applied by
#     deploy-staging.sh/rollback-staging.sh/recover-staging.sh whenever
#     DB_HOST below is set to something other than "db"). DB_SSLMODE=require
#     is mandatory for RDS — the connection is rejected without TLS otherwise
#     (backend/config/settings.py enforces this whenever DB_SSLMODE is set).
# DB_HOST=<rds-endpoint>.eu-north-1.rds.amazonaws.com
# DB_PORT=5432
# DB_SSLMODE=require
#
# --- Frontend ---
# Leave at /api. It is a BUILD-TIME variable baked into the JS bundle, and the
# nginx reverse proxy already forwards /api to the backend. An absolute URL
# would hardcode the EC2 IP into the bundle and force an image rebuild every
# time that IP changes.
# VITE_API_BASE_URL=/api
#
# --- Host ports ---
# 80 so the app is at http://<EC2_PUBLIC_IP> with no port suffix.
# FRONTEND_PORT=80
# Bind Gunicorn to loopback only, so port 8000 is never published on the
# public interface — defence in depth behind the security group.
# BACKEND_PORT=127.0.0.1:8000
# Leave POSTGRES_PORT unused: docker-compose.yml does not publish the db port
# at all, and it must never be exposed publicly (docs/AWS_STAGING_CHECKLIST.md §2b).
#
# --- Auth ---
# KarosL uses DRF Token authentication, not JWT. Tokens are database rows, so
# there is no separate JWT signing secret to configure — SECRET_KEY is the
# only cryptographic secret the app needs.
#
# --- TLS (deferred to the domain/SSL sprint) ---
# docker-compose.yml pins SECURE_SSL_REDIRECT / CSRF_COOKIE_SECURE /
# SESSION_COOKIE_SECURE to False, which is correct for HTTP-only staging —
# enabling them without TLS in front forces a redirect to a port nothing is
# listening on and locks you out. Flip all three to True when TLS is added.
# Once TLS is in place, docker-compose.https.yml sets all three plus
# USE_X_FORWARDED_PROTO, and STAGING_DOMAIN carries the hostname the nginx
# template is rendered with. The real hostname is never committed.
# STAGING_DOMAIN=<YOUR_DOMAIN>
#
# PUBLIC_IP: the bare EC2 public IP, served on its own Let's Encrypt
# IP-address certificate alongside STAGING_DOMAIN's — see
# docs/HTTPS_IP_CERTIFICATE.md. Both origins then need to be trusted:
# ALLOWED_HOSTS=<STAGING_DOMAIN>,<PUBLIC_IP>,localhost,127.0.0.1,backend
# CSRF_TRUSTED_ORIGINS=https://<STAGING_DOMAIN>,https://<PUBLIC_IP>
# CORS_ALLOWED_ORIGINS=https://<STAGING_DOMAIN>,https://<PUBLIC_IP>
# PUBLIC_IP=<YOUR_EC2_PUBLIC_IP>
#
# --- Backups to S3 (scripts/backup-to-s3.sh, docs/DEVOPS.md §12) ---
# Bucket for nightly pg_dump uploads. Left blank/absent here on purpose: the
# real bucket name identifies the AWS account, so it lives only in the server
# .env, exactly like the hostname and the secrets. Credentials are NOT
# configured here at all — the instance uses an EC2 instance role, so there
# are no AWS keys on the box.
# KAROSL_BACKUP_BUCKET=<your-backup-bucket>
# Optional: local dumps to retain on the instance (default 3).
# KEEP_LOCAL=3
